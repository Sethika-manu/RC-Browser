{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RCBrowser",
  "version": "1.3.6",
  "identifier": "com.royalcodex.browser.v1",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RC Browser",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src * asset: file: data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * asset: file: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src * asset: file: data: blob: 'unsafe-inline'; img-src * asset: file: data: blob: 'unsafe-inline'; frame-src * asset: file:; style-src * asset: file: 'unsafe-inline'; font-src * asset: file: data:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "**",
          "C:/**/*",
          "D:/**/*",
          "/*",
          "/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Royal Codex Software Solutions",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/Sethika-manu/dev-web/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFODFGQTNGMjM5QjVGMjcKUldRblg1c2pQL3FCWHJrZnFINlQvZUxRSFhiQUhsMXNUaERRKzlaWXBrTmxKU2pEdVc3QytUNzIK"
    },
    "shell": {
      "open": true
    }
  }
}